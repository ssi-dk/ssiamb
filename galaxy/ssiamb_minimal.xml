<tool id="ssiamb" name="Ambiguous Sites Counter" version="0.9.0" profile="22.05" license="MIT">
    <description>Count ambiguous sites in bacterial WGS data</description>
    
    <requirements>
        <requirement type="package" version="0.9.0">ssiamb</requirement>
    </requirements>
    
    <command detect_errors="exit_code"><![CDATA[
        #import re
        
        #set $sample_name = re.sub('[^\w\-\s]', '_', str($reads.name))
        
        ssiamb self
        --r1 '$reads.forward'
        --r2 '$reads.reverse'
        --assembly '$assembly'
        --sample '${sample_name}'
    ]]></command>
    
    <inputs>
        <param name="reads" type="data_collection" collection_type="paired" format="fastq,fastq.gz,fastqsanger,fastqsanger.gz" label="Paired reads collection"/>
        <param name="assembly" type="data" format="fasta" label="Assembly"/>
    </inputs>
    
    <outputs>
        <data format="tsv" name="output" from_work_dir="*_ambiguous_summary.tsv" label="${tool.name} on ${on_string}: Summary" />
    </outputs>
    
    <tests>
        <test expect_num_outputs="1">
            <param name="reads">
                <collection type="paired">
                    <element name="forward" value="test_R1.fastq"/>
                    <element name="reverse" value="test_R2.fastq"/>
                </collection>
            </param>
            <param name="assembly" value="test_assembly.fasta"/>
            <output name="output">
                <assert_contents>
                    <has_text text="sample"/>
                    <has_text text="ambiguous_snv_count"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    
    <help><![CDATA[
**What it does**

Identifies ambiguous sites in bacterial whole genome sequencing data by mapping reads to their own assembly (self-mapping mode).

**Output**

A summary TSV file with ambiguous site counts and quality metrics.
    ]]></help>
    
