<tool id="ssiamb_self" name="SSI Ambiguous Sites" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>count ambiguous SNV sites from reads mapped to a supplied assembly</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="creator"/>
    <expand macro="requirements"/>
    <version_command>ssiamb --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
        #import re
        #set $clean_sample = re.sub(r'[^A-Za-z0-9._-]', '_', str($sample_name))
        mkdir -p outputs &&
        ssiamb self
            --r1 '$r1'
            --r2 '$r2'
            --assembly '$assembly'
            --sample '$clean_sample'
            --outdir outputs
            --threads \${GALAXY_SLOTS:-1}
            --dp-min '$thresholds.dp_min'
            --maf-min '$thresholds.maf_min'
            --dp-cap '$thresholds.dp_cap'
            #if $advanced.bbtools_mem
                --bbtools-mem '$advanced.bbtools_mem'
            #end if
            #if $advanced.keep_intermediates
                --keep-intermediates
            #end if
    ]]></command>
    <inputs>
        <param name="r1" type="data" format="fastq,fastq.gz,fastqsanger,fastqsanger.gz" label="Forward reads (R1)" help="Trimmed forward reads."/>
        <param name="r2" type="data" format="fastq,fastq.gz,fastqsanger,fastqsanger.gz" label="Reverse reads (R2)" help="Trimmed reverse reads."/>
        <param name="assembly" type="data" format="fasta,fasta.gz" label="Shovill assembly" help="Assembly produced upstream, for example by Shovill."/>
        <param name="sample_name" type="text" label="Sample name" help="Used in reports and output filenames."/>
        <section name="thresholds" title="Thresholds" expanded="true">
            <param name="dp_min" type="integer" value="10" min="1" label="Minimum depth"/>
            <param name="maf_min" type="float" value="0.10" min="0" max="0.5" label="Minimum minor allele frequency"/>
            <param name="dp_cap" type="integer" value="100" min="1" label="Depth cap for matrix/reporting"/>
        </section>
        <section name="advanced" title="Advanced options" expanded="false">
            <param name="bbtools_mem" type="text" optional="true" label="BBTools heap size" help="Optional value without -Xmx prefix, for example 4g."/>
            <param name="keep_intermediates" type="boolean" checked="false" label="Keep sorted BAM intermediate"/>
        </section>
    </inputs>
    <outputs>
        <data name="summary" format="tabular" label="${tool.name} on ${on_string}: summary" from_work_dir="outputs/*.summary.tsv"/>
        <data name="loci" format="tabular" label="${tool.name} on ${on_string}: loci" from_work_dir="outputs/*.loci.tsv"/>
        <data name="matrix" format="tabular" label="${tool.name} on ${on_string}: matrix" from_work_dir="outputs/*.matrix.tsv"/>
        <data name="variants" format="vcf" label="${tool.name} on ${on_string}: variants" from_work_dir="outputs/*.variants.vcf"/>
        <data name="provenance" format="json" label="${tool.name} on ${on_string}: provenance" from_work_dir="outputs/*.provenance.json"/>
    </outputs>
    <tests>
        <test expect_num_outputs="5">
            <param name="r1" value="tiny_R1.fastq"/>
            <param name="r2" value="tiny_R2.fastq"/>
            <param name="assembly" value="tiny_assembly.fasta"/>
            <param name="sample_name" value="tiny"/>
            <section name="thresholds">
                <param name="dp_min" value="1"/>
                <param name="maf_min" value="0.10"/>
                <param name="dp_cap" value="100"/>
            </section>
            <output name="summary">
                <assert_contents>
                    <has_text text="sample"/>
                    <has_text text="ambiguous_sites"/>
                    <has_text text="dp_min"/>
                    <has_text text="maf_min"/>
                    <has_text text="tiny"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
`ssiamb` expects trimmed paired-end reads and a supplied assembly. It maps the
reads back to the assembly, calls variants with BBTools, groups same-position
VCF records, and counts ambiguous SNV loci using depth and minor allele
frequency thresholds.
    ]]></help>
    <expand macro="citations"/>
</tool>
